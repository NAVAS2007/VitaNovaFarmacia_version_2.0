@page
@model CarritoModel
@{
    ViewData["Title"] = "VitaNova - Punto de Venta (POS)";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-center">
                    <div class="col-md-9">
                        <label class="form-label fw-semibold mb-0">
                            <i class="bi bi-search"></i> Buscar medicamento
                            <span class="key-hint">F2</span>
                        </label>
                        <input type="text" id="buscadorProductos" 
                               class="form-control pos-hotkey" 
                               placeholder="Escriba nombre, principio activo o codigo de barras..." 
                               onkeyup="buscarProductos(this.value)" 
                               autofocus />
                    </div>
                    <div class="col-md-3 text-end">
                        <span class="text-muted small">
                            <span class="key-hint">F2</span> Buscar 
                            <span class="key-hint">F10</span> Cobrar
                        </span>
                    </div>
                </div>
                <div id="resultadosBusqueda" class="pos-search-results mt-2" style="display: none;">
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-cart"></i> Carrito de Compras</h4>
            </div>
            <div class="card-body p-0">
                @if (Model.Items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 35%;">Producto</th>
                                    <th class="text-center" style="width: 20%;">Cantidad</th>
                                    <th class="text-end" style="width: 20%;">Precio</th>
                                    <th class="text-end" style="width: 20%;">Subtotal</th>
                                    <th style="width: 5%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="carrito-item" data-producto-id="@item.ProductoID">
                                        <td>
                                            <strong>@item.Nombre</strong>
                                            <br />
                                            <small class="text-muted">@item.ComponenteActivo</small>
                                        </td>
                                        <td class="text-center">
                                            <div class="input-group input-group-sm" style="width: 100px; margin: 0 auto;">
                                                <button class="btn btn-outline-secondary" onclick="cambiarCantidad(@item.ProductoID, -1)">-</button>
                                                <input type="number" class="form-control text-center" value="@item.Cantidad" min="1" readonly />
                                                <button class="btn btn-outline-secondary" onclick="cambiarCantidad(@item.ProductoID, 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end">@item.PrecioUnitario.ToString("C")</td>
                                        <td class="text-end fw-bold">@item.Subtotal.ToString("C")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" onclick="eliminarProducto(@item.ProductoID)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="3" class="text-end fs-5">Total a Pagar</td>
                                    <td class="text-end fs-4 text-primary" id="totalVenta" data-total="@Model.Total">@Model.Total.ToString("C")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-cart-x" style="font-size: 64px; color: #ccc;"></i>
                        <h4 class="mt-3">El carrito esta vacio</h4>
                        <p class="text-muted">Use el buscador o vaya a Productos para agregar items</p>
                        <a href="/Productos" class="btn btn-primary">
                            <i class="bi bi-box-seam"></i> Ver Productos
                        </a>
                        <span class="text-muted small d-block mt-2">Presione <span class="key-hint">F2</span> para buscar</span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-credit-card"></i> Procesar Pago</h5>
            </div>
            <div class="card-body">
                @if (Model.Items.Any())
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cliente</label>
                        <select asp-for="ClienteID" class="form-select">
                            <option value="">Seleccione un cliente</option>
                            @foreach (var cliente in Model.Clientes)
                            {
                                <option value="@cliente.ID">@cliente.Nombre - @cliente.Documento</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Metodo de Pago</label>
                        <div class="d-flex gap-2">
                            <div class="form-check">
                                <input type="radio" name="metodoPago" value="1" class="form-check-input" 
                                       id="efectivoRadio"
                                       onchange="mostrarSeccionPago('efectivo')" />
                                <label class="form-check-label" for="efectivoRadio">Efectivo <span class="key-hint">Ctrl+E</span></label>
                            </div>
                            <div class="form-check">
                                <input type="radio" name="metodoPago" value="2" class="form-check-input" 
                                       id="tarjetaRadio"
                                       onchange="mostrarSeccionPago('tarjeta')" />
                                <label class="form-check-label" for="tarjetaRadio">Tarjeta <span class="key-hint">Ctrl+T</span></label>
                            </div>
                        </div>
                    </div>

                    <div id="seccionEfectivo" class="d-none border p-3 rounded-3 bg-light mb-3">
                        <label class="form-label fw-semibold">Monto Recibido</label>
                        <input type="number" step="0.01" class="form-control" id="montoRecibido" oninput="calcularCambio()" />
                        <div id="cambioDiv" class="mt-2" style="display: none;">
                            <span class="fw-bold">Cambio: </span>
                            <span class="text-success fw-bold" id="cambio">$0.00</span>
                        </div>
                    </div>

                    <div id="seccionTarjeta" class="d-none border p-3 rounded-3 bg-light mb-3">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-shield-lock"></i> Pasarela de Pago</h6>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Numero de Tarjeta</label>
                            <input type="text" class="form-control" placeholder="0000 0000 0000 0000" />
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Vencimiento</label>
                                <input type="text" class="form-control" placeholder="MM/AA" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">CVV</label>
                                <input type="password" class="form-control" placeholder="***" />
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <strong>Total:</strong> @Model.Total.ToString("C")
                    </div>

                    <form method="post" asp-page-handler="ProcesarVenta">
                        <input type="hidden" asp-for="ClienteID" />
                        <input type="hidden" asp-for="MetodoPagoID" id="metodoPagoHidden" />
                        <input type="hidden" asp-for="Recibido" id="recibidoHidden" />
                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold" id="btnProcesarVenta">
                            <i class="bi bi-check-circle"></i> Procesar Venta <span class="key-hint">F10</span>
                        </button>
                    </form>

                    <div class="mt-3 text-center small text-muted">
                        <span class="key-hint">F2</span> Buscar 
                        <span class="key-hint">F10</span> Cobrar 
                        <span class="key-hint">Ctrl+E</span> Efectivo 
                        <span class="key-hint">Ctrl+T</span> Tarjeta
                        <br />
                        <span class="key-hint">Delete</span> Eliminar item
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-cart" style="font-size: 48px; color: #ccc;"></i>
                        <p class="text-muted mt-2">Agregue productos para procesar el pago</p>
                        <a href="/Productos" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-box-seam"></i> Ir a Productos
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarSeccionPago(tipo) {
            var efectivoDiv = document.getElementById('seccionEfectivo');
            var tarjetaDiv = document.getElementById('seccionTarjeta');
            var hidden = document.getElementById('metodoPagoHidden');

            if (tipo === 'efectivo') {
                efectivoDiv.classList.remove('d-none');
                tarjetaDiv.classList.add('d-none');
                hidden.value = '1';
            } else {
                tarjetaDiv.classList.remove('d-none');
                efectivoDiv.classList.add('d-none');
                hidden.value = '2';
            }
        }

        function buscarProductos(termino) {
            clearTimeout(window.buscarTimeout);
            var resultadosDiv = document.getElementById('resultadosBusqueda');
            
            if (!termino || termino.length < 2) {
                resultadosDiv.style.display = 'none';
                return;
            }

            window.buscarTimeout = setTimeout(function() {
                fetch('/Ventas/Carrito?handler=Buscar&termino=' + encodeURIComponent(termino))
                    .then(function(response) {
                        if (!response.ok) {
                            throw new Error('Error: ' + response.status);
                        }
                        return response.json();
                    })
                    .then(function(data) {
                        if (data.length > 0) {
                            resultadosDiv.innerHTML = data.map(function(p) {
                                return '<button class="list-group-item list-group-item-action" onclick="agregarAlCarrito(' + p.id + ', \'' + p.nombre + '\', ' + p.precio + ')">' +
                                    '<div class="d-flex justify-content-between align-items-center">' +
                                        '<div>' +
                                            '<strong>' + p.nombre + '</strong>' +
                                            '<br /><small class="text-muted">' + (p.componenteActivo || '') + '</small>' +
                                        '</div>' +
                                        '<div class="text-end">' +
                                            '<span class="badge bg-primary">$' + p.precio.toFixed(2) + '</span>' +
                                            '<br /><small class="text-muted">Stock: ' + p.stock + '</small>' +
                                        '</div>' +
                                    '</div>' +
                                '</button>';
                            }).join('');
                            resultadosDiv.style.display = 'block';
                        } else {
                            resultadosDiv.innerHTML = '<div class="list-group-item text-muted">No se encontraron productos</div>';
                            resultadosDiv.style.display = 'block';
                        }
                    })
                    .catch(function(error) {
                        console.error('Error:', error);
                        resultadosDiv.innerHTML = '<div class="list-group-item text-danger">Error al buscar productos</div>';
                        resultadosDiv.style.display = 'block';
                    });
            }, 300);
        }

        function agregarAlCarrito(id, nombre, precio) {
            fetch('/Ventas/Carrito?handler=Agregar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    productoID: id, 
                    nombre: nombre, 
                    precio: precio, 
                    cantidad: 1 
                })
            })
            .then(function(response) {
                return response.json();
            })
            .then(function(data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Error al agregar producto');
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                alert('Error al agregar producto');
            });
        }

        function cambiarCantidad(productoID, delta) {
            fetch('/Ventas/Carrito?handler=ActualizarCantidad', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productoID: productoID, cantidad: delta })
            })
            .then(function(response) {
                return response.json();
            })
            .then(function(data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Error al actualizar cantidad');
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
                alert('Error al actualizar cantidad');
            });
        }

        function eliminarProducto(productoID) {
            if (confirm('Eliminar este producto del carrito?')) {
                fetch('/Ventas/Carrito?handler=Eliminar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productoID: productoID })
                })
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                    alert('Error al eliminar producto');
                });
            }
        }

        function calcularCambio() {
            var recibido = parseFloat(document.getElementById('montoRecibido').value) || 0;
            var totalElement = document.getElementById('totalVenta');
            var total = totalElement ? parseFloat(totalElement.dataset.total) || 0 : 0;
            var cambioDiv = document.getElementById('cambioDiv');
            var cambioSpan = document.getElementById('cambio');

            if (recibido > 0 && recibido >= total) {
                var cambio = recibido - total;
                cambioSpan.textContent = '$' + cambio.toFixed(2);
                cambioDiv.style.display = 'block';
                document.getElementById('recibidoHidden').value = recibido;
            } else {
                cambioDiv.style.display = 'none';
            }
        }

        // ============================================================
        // TECLADO RAPIDO (RF-06)
        // ============================================================
        document.addEventListener('keydown', function(e) {
            // F2: Enfocar buscador
            if (e.key === 'F2') {
                e.preventDefault();
                var buscador = document.getElementById('buscadorProductos');
                if (buscador) {
                    buscador.focus();
                    buscador.select();
                }
                return;
            }

            // F10: Procesar cobro
            if (e.key === 'F10') {
                e.preventDefault();
                var btn = document.getElementById('btnProcesarVenta');
                if (btn) {
                    btn.click();
                }
                return;
            }

            // Escape: Cerrar resultados
            if (e.key === 'Escape') {
                var resultados = document.getElementById('resultadosBusqueda');
                if (resultados) {
                    resultados.style.display = 'none';
                }
                return;
            }

            // Ctrl+E: Efectivo
            if (e.ctrlKey && e.key === 'e') {
                e.preventDefault();
                var efectivoRadio = document.getElementById('efectivoRadio');
                if (efectivoRadio) {
                    efectivoRadio.checked = true;
                    mostrarSeccionPago('efectivo');
                }
                return;
            }

            // Ctrl+T: Tarjeta
            if (e.ctrlKey && e.key === 't') {
                e.preventDefault();
                var tarjetaRadio = document.getElementById('tarjetaRadio');
                if (tarjetaRadio) {
                    tarjetaRadio.checked = true;
                    mostrarSeccionPago('tarjeta');
                }
                return;
            }
        });
    </script>
}