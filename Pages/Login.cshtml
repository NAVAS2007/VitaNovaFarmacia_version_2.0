@page
@model LoginModel
@{
    ViewData["Title"] = "VitaNova - Iniciar Sesion";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
            body {
                background-image: url('https://static.vecteezy.com/system/resources/thumbnails/042/231/606/small/health-care-and-abstract-geometric-medical-background-with-icons-concept-and-idea-for-healthcare-technology-innovation-medicine-healthcare-science-design-vector.jpg');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-attachment: fixed;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
            }

            .login-card {
                background: #0a1e3d; 
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
                border-radius: 16px;
                padding: 2.5rem;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
                max-width: 420px;
                width: 100%;
                border: 1px solid rgba(255, 255, 255, 0.15);
            }

            .farmacia-icon {
                font-size: 48px;
                color: #4d8bf7;
                display: block;
                text-align: center;
                margin-bottom: 0.5rem;
            }

            .login-card h3 {
                color: #ffffff !important;
            }

            .login-card p {
                color: #c8d6e5 !important;
            }

            .login-card label {
                color: #ffffff !important;
            }

            .login-card .form-control {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #ffffff;
            }

                .login-card .form-control:focus {
                    background: rgba(255, 255, 255, 0.15);
                    border-color: #4d8bf7;
                    color: #ffffff;
                    box-shadow: 0 0 0 0.25rem rgba(77, 139, 247, 0.25);
                }

                .login-card .form-control::placeholder {
                    color: rgba(255, 255, 255, 0.5);
                }

            .login-card .input-group-text {
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: #4d8bf7;
            }

            .btn-primary {
                background-color: #4d8bf7 !important;
                border-color: #4d8bf7 !important;
                color: #ffffff !important;
                font-weight: 600;
                padding: 12px;
                border-radius: 8px;
                transition: all 0.3s ease;
            }

                .btn-primary:hover {
                    background-color: #6aa0ff !important;
                    border-color: #6aa0ff !important;
                    transform: translateY(-1px);
                    box-shadow: 0 4px 15px rgba(77, 139, 247, 0.4);
                }

            .alert-danger {
                background: rgba(220, 53, 69, 0.2);
                border-color: rgba(220, 53, 69, 0.3);
                color: #ff6b7a;
            }

                .alert-danger .btn-close {
                    filter: brightness(0) invert(1);
                }


            .login-card hr {
                border-color: rgba(255, 255, 255, 0.1);
            }

            .login-card .text-muted {
                color: #8fa8c8 !important;
            }

            .text-danger {
                color: #ff6b7a !important;
            }
    </style>
</head>
<body>
    <div class="container d-flex justify-content-center">
        <div class="login-card">
            <div class="farmacia-icon">
                <i class="bi bi-capsule"></i>
            </div>
            <h3 class="text-center fw-bold mb-4" style="color: #0a58ca;">VitaNova Farmacia</h3>
            <p class="text-center text-muted mb-4">Ingrese sus credenciales para acceder</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Correo electronico</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control" placeholder="correo@ejemplo.com" required autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Contrasena</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="********" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar
                </button>
            </form>
            <hr />
            <p class="text-center text-muted small mb-0">
                Sistema de Gestion Farmaceutica &copy; @DateTime.Now.Year
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>