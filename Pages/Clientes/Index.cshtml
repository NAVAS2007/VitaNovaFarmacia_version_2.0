@page
@model IndexModel
@{
    ViewData["Title"] = "VitaNova - Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold"><i class="bi bi-people text-primary"></i> Gestion de Clientes</h2>
        <p class="text-muted">Administre la informacion de los clientes</p>
    </div>
    <div>
        <a href="/Clientes/Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Cliente
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input asp-for="BuscarTermino" class="form-control" placeholder="Buscar por nombre, documento o telefono..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Buscar</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Documento</th>
                        <th>Nombre</th>
                        <th>Telefono</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes.Any())
                    {
                        @foreach (var cliente in Model.Clientes)
                        {
                            <tr>
                                <td class="fw-semibold">@cliente.Documento</td>
                                <td>@cliente.Nombre @cliente.Apellido</td>
                                <td>@(cliente.Telefono ?? "N/A")</td>
                                <td>@(cliente.Correo ?? "N/A")</td>
                                <td>
                                    @if (cliente.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Clientes/Editar/@cliente.ID" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Clientes/Eliminar/@cliente.ID" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-3"></i>
                                <h5>No hay clientes registrados</h5>
                                <p>Agregue un cliente para comenzar.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>