@page
@model CrearModel
@{
    ViewData["Title"] = "VitaNova - Nuevo Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-person-plus"></i> Nuevo Cliente</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Cliente.Documento" class="form-label fw-semibold">Documento</label>
                        <input asp-for="Cliente.Documento" class="form-control" placeholder="Ej. 001-123456-7" required />
                        <span asp-validation-for="Cliente.Documento" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cliente.Nombre" class="form-label fw-semibold">Nombre</label>
                        <input asp-for="Cliente.Nombre" class="form-control" placeholder="Ej. Carlos" required />
                        <span asp-validation-for="Cliente.Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cliente.Apellido" class="form-label fw-semibold">Apellido</label>
                        <input asp-for="Cliente.Apellido" class="form-control" placeholder="Ej. Mendoza" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cliente.Telefono" class="form-label fw-semibold">Telefono</label>
                        <input asp-for="Cliente.Telefono" class="form-control" placeholder="Ej. 7123-4567" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cliente.Correo" class="form-label fw-semibold">Correo Electronico</label>
                        <input asp-for="Cliente.Correo" type="email" class="form-control" placeholder="cliente@ejemplo.com" />
                        <span asp-validation-for="Cliente.Correo" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Cliente.Direccion" class="form-label fw-semibold">Direccion</label>
                        <textarea asp-for="Cliente.Direccion" class="form-control" rows="2" placeholder="Direccion completa"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Clientes" class="btn btn-outline-secondary w-50">Cancelar</a>
                        <button type="submit" class="btn btn-primary w-50">
                            <i class="bi bi-save"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}