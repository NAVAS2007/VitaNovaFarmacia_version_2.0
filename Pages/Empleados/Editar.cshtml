@page "{id:int}"
@model EditarModel
@{
    ViewData["Title"] = "VitaNova - Editar Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Editar Empleado</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Empleado.ID" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Empleado.Nombre" class="form-label fw-semibold">Nombre Completo</label>
                        <input asp-for="Empleado.Nombre" class="form-control" required />
                        <span asp-validation-for="Empleado.Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Empleado.Email" class="form-label fw-semibold">Correo Electronico</label>
                        <input asp-for="Empleado.Email" type="email" class="form-control" required />
                        <span asp-validation-for="Empleado.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Empleado.RolID" class="form-label fw-semibold">Rol</label>
                        <select asp-for="Empleado.RolID" asp-items="Model.ListaRoles" class="form-select" required>
                            <option value="">Seleccione un rol</option>
                        </select>
                        <span asp-validation-for="Empleado.RolID" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Empleado.Activo" class="form-check-input" />
                            <label asp-for="Empleado.Activo" class="form-check-label">Empleado activo</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Empleados" class="btn btn-outline-secondary w-50">Cancelar</a>
                        <button type="submit" class="btn btn-warning w-50">
                            <i class="bi bi-save"></i> Actualizar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}