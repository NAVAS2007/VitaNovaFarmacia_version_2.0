@page
@model IndexModel
@{
    ViewData["Title"] = "VitaNova - Empleados";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold"><i class="bi bi-person-badge text-primary"></i> Gestion de Empleados</h2>
        <p class="text-muted">Administre el personal de la farmacia</p>
        <p class="text-muted">Total: <strong>@Model.Empleados.Count</strong> empleados</p>
    </div>
    <div>
        <a href="/Empleados/Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Empleado
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Avatar</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Empleados.Any())
                    {
                        @foreach (var empleado in Model.Empleados)
                        {
                            <tr>
                                <td>
                                    <img src="https://ui-avatars.com/api/?name=@empleado.Nombre.Replace(" ", "+")&background=0d6efd&color=fff&size=40&rounded=true"
                                         class="rounded-circle"
                                         style="width:40px;height:40px;object-fit:cover;" />
                                </td>
                                <td class="fw-semibold">@empleado.Nombre</td>
                                <td>@empleado.Email</td>
                                <td>
                                    <span class="badge bg-primary">@(empleado.Rol?.NombreRole ?? "Sin rol")</span>
                                </td>
                                <td>
                                    @if (empleado.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Empleados/Editar/@empleado.ID" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Empleados/Eliminar/@empleado.ID" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-person-badge fs-1 d-block mb-3"></i>
                                <h5>No hay empleados registrados</h5>
                                <p>Agregue un empleado para comenzar.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>