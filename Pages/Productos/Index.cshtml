@page
@model IndexModel
@{
    ViewData["Title"] = "VitaNova - Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold"><i class="bi bi-box-seam text-primary"></i> Inventario de Productos</h2>
        <p class="text-muted">Gestion de medicamentos y productos de la farmacia</p>
    </div>
    <div>
        <a href="/Productos/Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Producto
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h3 class="fw-bold text-primary">@Model.TotalProductosStock</h3>
                <span class="text-muted">Unidades disponibles</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h3 class="fw-bold text-danger">@Model.ProductosStockCritico</h3>
                <span class="text-muted">Productos con stock critico</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h3 class="fw-bold text-warning">@Model.LotesPorVencer</h3>
                <span class="text-muted">Lotes proximos a vencer</span>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Codigo</th>
                        <th>Producto</th>
                        <th>Categoria</th>
                        <th>Precio</th>
                        <th class="text-center">Stock</th>
                        <th>Lote Activo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Productos.Any())
                    {
                        @foreach (var producto in Model.Productos)
                        {
                            <tr>
                                <td>@(producto.CodigoBarras ?? "N/A")</td>
                                <td>
                                    <strong>@producto.Nombre</strong>
                                    <br />
                                    <small class="text-muted">@producto.ComponenteActivo</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@producto.Categoria</span>
                                </td>
                                <td>@producto.Precio.ToString("C")</td>
                                <td class="text-center">
                                    @if (producto.EsCritico)
                                    {
                                        <span class="badge bg-danger">@producto.StockTotal</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@producto.StockTotal</span>
                                    }
                                </td>
                                <td>@producto.InfoLote</td>
                                <td class="text-center">
                                    <!-- Boton Agregar al Carrito -->
                                    @if (producto.StockTotal > 0)
                                    {
                                        <button class="btn btn-sm btn-success"
                                                onclick="agregarAlCarrito(@producto.ID, '@producto.Nombre', @producto.Precio.ToString().Replace(",", "."))">
                                            <i class="bi bi-cart-plus"></i> Agregar
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled>
                                            <i class="bi bi-cart-x"></i> Agotado
                                        </button>
                                    }

                                    <a href="/Productos/Editar/@producto.ID" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Productos/Eliminar/@producto.ID" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam fs-1 d-block mb-3"></i>
                                <h5>No hay productos registrados</h5>
                                <p>Agregue un medicamento para comenzar.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- SCRIPT PARA AGREGAR AL CARRITO                                -->
<!-- ============================================================ -->
@section Scripts {
    <script>
        function agregarAlCarrito(id, nombre, precio) {
            console.log("=== AGREGANDO: " + nombre + " (ID: " + id + ") ===");

            fetch('/Ventas/Carrito?handler=Agregar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    productoID: id,
                    nombre: nombre,
                    precio: precio,
                    cantidad: 1
                })
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Error en la peticion: ' + response.status);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log("=== RESPUESTA: " + JSON.stringify(data) + " ===");
                    if (data.success) {
                        alert('Producto agregado al carrito');
                    } else {
                        alert(data.message || 'Error al agregar producto');
                    }
                })
                .catch(error => {
                    console.error("=== ERROR: " + error + " ===");
                    alert('Error al agregar producto. Verifique que haya iniciado sesion.');
                });
        }
    </script>
}