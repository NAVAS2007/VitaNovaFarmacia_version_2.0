@page
@model CrearModel
@{
    ViewData["Title"] = "VitaNova - Nuevo Producto";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Nuevo Medicamento</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Producto.Nombre" class="form-label fw-semibold">Nombre del Medicamento</label>
                        <input asp-for="Producto.Nombre" class="form-control" placeholder="Ej. Paracetamol 500mg" required />
                        <span asp-validation-for="Producto.Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Producto.CodigoBarras" class="form-label fw-semibold">Codigo de Barras</label>
                        <input asp-for="Producto.CodigoBarras" class="form-control" placeholder="Ej. 750123456789" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Producto.IdCategoria" class="form-label fw-semibold">Categoria</label>
                        <select asp-for="Producto.IdCategoria" asp-items="Model.ListaCategorias" class="form-select" required>
                            <option value="">Seleccione una categoria</option>
                        </select>
                        <span asp-validation-for="Producto.IdCategoria" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Producto.ComponenteActivo" class="form-label fw-semibold">Componente Activo</label>
                        <textarea asp-for="Producto.ComponenteActivo" class="form-control" rows="2" placeholder="Ej. Acetaminofen 500mg"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Producto.Precio" class="form-label fw-semibold">Precio ($)</label>
                            <input asp-for="Producto.Precio" type="number" step="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Producto.StockMinimo" class="form-label fw-semibold">Stock Minimo</label>
                            <input asp-for="Producto.StockMinimo" type="number" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CantidadInicial" class="form-label fw-semibold">Cantidad Inicial</label>
                        <input asp-for="CantidadInicial" type="number" class="form-control" placeholder="Ej. 100" required />
                        <span asp-validation-for="CantidadInicial" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Producto.RequiereReceta" class="form-check-input" />
                            <label asp-for="Producto.RequiereReceta" class="form-check-label">Requiere receta medica</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Productos" class="btn btn-outline-secondary w-50">Cancelar</a>
                        <button type="submit" class="btn btn-primary w-50">
                            <i class="bi bi-save"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}