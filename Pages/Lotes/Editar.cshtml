@page "{id:int}"
@model EditarModel
@{
    ViewData["Title"] = "VitaNova - Editar Lote";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Editar Lote</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Lote.ID" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Lote.ProductoID" class="form-label fw-semibold">Producto</label>
                        <select asp-for="Lote.ProductoID" asp-items="Model.ListaProductos" class="form-select" required>
                            <option value="">Seleccione un producto</option>
                        </select>
                        <span asp-validation-for="Lote.ProductoID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lote.NumeroLote" class="form-label fw-semibold">Numero de Lote</label>
                        <input asp-for="Lote.NumeroLote" class="form-control" required />
                        <span asp-validation-for="Lote.NumeroLote" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lote.Cantidad" class="form-label fw-semibold">Cantidad</label>
                        <input asp-for="Lote.Cantidad" type="number" min="0" class="form-control" required />
                        <span asp-validation-for="Lote.Cantidad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lote.CostoAdquisicion" class="form-label fw-semibold">Costo de Adquisicion ($)</label>
                        <input asp-for="Lote.CostoAdquisicion" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="Lote.CostoAdquisicion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lote.ProveedorID" class="form-label fw-semibold">Proveedor</label>
                        <select asp-for="Lote.ProveedorID" asp-items="Model.ListaProveedores" class="form-select">
                            <option value="">Seleccione un proveedor</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lote.FechaVencimiento" class="form-label fw-semibold">Fecha de Vencimiento</label>
                        <input asp-for="Lote.FechaVencimiento" type="date" class="form-control" required />
                        <span asp-validation-for="Lote.FechaVencimiento" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Lote.Activo" class="form-check-input" />
                            <label asp-for="Lote.Activo" class="form-check-label">Lote activo</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Lotes" class="btn btn-outline-secondary w-50">Cancelar</a>
                        <button type="submit" class="btn btn-warning w-50">
                            <i class="bi bi-save"></i> Actualizar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}