@page
@model IndexModel
@{
    ViewData["Title"] = "VitaNova - Lotes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold"><i class="bi bi-layers text-primary"></i> Gestion de Lotes</h2>
        <p class="text-muted">Control de lotes por fecha de vencimiento</p>
    </div>
    <div>
        <a href="/Lotes/Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Lote
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Numero de Lote</th>
                        <th>Cantidad</th>
                        <th>Costo</th>
                        <th>Fecha Ingreso</th>
                        <th>Fecha Vencimiento</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lotes.Any())
                    {
                        @foreach (var lote in Model.Lotes)
                        {
                            <tr>
                                <td class="fw-semibold">@(lote.Producto?.Nombre ?? "Sin producto")</td>
                                <td>@lote.NumeroLote</td>
                                <td>
                                    <span class="badge bg-success">@lote.Cantidad</span>
                                </td>
                                <td>@lote.CostoAdquisicion.ToString("C")</td>
                                <td>@lote.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (lote.FechaVencimiento <= DateTime.Now.AddDays(30))
                                    {
                                        <span class="badge bg-danger">@lote.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                                    }
                                    else if (lote.FechaVencimiento <= DateTime.Now.AddDays(90))
                                    {
                                        <span class="badge bg-warning text-dark">@lote.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@lote.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                                    }
                                </td>
                                <td>
                                    @if (lote.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Agotado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Lotes/Editar/@lote.ID" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Lotes/Eliminar/@lote.ID" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-layers fs-1 d-block mb-3"></i>
                                <h5>No hay lotes registrados</h5>
                                <p>Agregue un lote para comenzar.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>