@page "{id:int}"
@model EditarModel
@{
    ViewData["Title"] = "VitaNova - Editar Proveedor";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Editar Proveedor</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Proveedor.ID" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Proveedor.Nombre" class="form-label fw-semibold">Nombre</label>
                        <input asp-for="Proveedor.Nombre" class="form-control" required />
                        <span asp-validation-for="Proveedor.Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Proveedor.Telefono" class="form-label fw-semibold">Telefono</label>
                        <input asp-for="Proveedor.Telefono" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Proveedor.Correo" class="form-label fw-semibold">Correo Electronico</label>
                        <input asp-for="Proveedor.Correo" type="email" class="form-control" />
                        <span asp-validation-for="Proveedor.Correo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Proveedor.Direccion" class="form-label fw-semibold">Direccion</label>
                        <textarea asp-for="Proveedor.Direccion" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Proveedor.NIT" class="form-label fw-semibold">NIT</label>
                        <input asp-for="Proveedor.NIT" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Proveedor.Activo" class="form-check-input" />
                            <label asp-for="Proveedor.Activo" class="form-check-label">Proveedor activo</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/Proveedores" class="btn btn-outline-secondary w-50">Cancelar</a>
                        <button type="submit" class="btn btn-warning w-50">
                            <i class="bi bi-save"></i> Actualizar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}