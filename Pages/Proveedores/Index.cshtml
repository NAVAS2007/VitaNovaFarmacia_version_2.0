@page
@model IndexModel
@{
    ViewData["Title"] = "VitaNova - Proveedores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold"><i class="bi bi-truck text-primary"></i> Gestion de Proveedores</h2>
        <p class="text-muted">Administre los proveedores de la farmacia</p>
    </div>
    <div>
        <a href="/Proveedores/Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Proveedor
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Telefono</th>
                        <th>Correo</th>
                        <th>NIT</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Proveedores.Any())
                    {
                        @foreach (var proveedor in Model.Proveedores)
                        {
                            <tr>
                                <td class="fw-semibold">@proveedor.Nombre</td>
                                <td>@(proveedor.Telefono ?? "N/A")</td>
                                <td>@(proveedor.Correo ?? "N/A")</td>
                                <td>@(proveedor.NIT ?? "N/A")</td>
                                <td>
                                    @if (proveedor.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Proveedores/Editar/@proveedor.ID" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Proveedores/Eliminar/@proveedor.ID" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-truck fs-1 d-block mb-3"></i>
                                <h5>No hay proveedores registrados</h5>
                                <p>Agregue un proveedor para comenzar.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>